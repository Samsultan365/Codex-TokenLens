{
  "name": "codex-usage-panel",
  "version": "1.0.1",
  "description": "Small inline panel for Codex token usage, context occupancy, and provider balance. Auto-detects DeepSeek, OpenAI, OpenRouter, and OpenAI-compatible providers.",
  "author": {
    "name": "Codex Usage Panel contributors"
  },
  "license": "MIT",
  "keywords": [
    "codex",
    "usage",
    "tokens",
    "balance",
    "deepseek",
    "openai",
    "monitoring"
  ],
  "skills": "./skills/",
  "mcpServers": "./.mcp.json",
  "hooks": {
    "hooks": {
      "SessionStart": [
        {
          "hooks": [
            {
              "type": "mcp_tool",
              "server": "codex-usage-panel",
              "tool": "codex_usage_sync_thread",
              "input": {
                "session_id": "${session_id}"
              }
            }
          ]
        }
      ],
      "UserPromptSubmit": [
        {
          "hooks": [
            {
              "type": "mcp_tool",
              "server": "codex-usage-panel",
              "tool": "codex_usage_sync_thread",
              "input": {
                "session_id": "${session_id}"
              }
            }
          ]
        }
      ]
    }
  },
  "interface": {
    "displayName": "Codex TokenLens",
    "shortDescription": "Token usage and balance in chat",
    "longDescription": "A local, read-only Codex plugin that shows the latest thread token usage, context occupancy, and provider balance. It reads local Codex session logs and queries a configured provider balance endpoint. No session content is uploaded.",
    "developerName": "Codex Usage Panel contributors",
    "category": "Productivity",
    "capabilities": [
      "Interactive",
      "Read"
    ],
    "defaultPrompt": [
      "Show my Codex usage",
      "Check my provider balance",
      "Show Codex tokens and balance"
    ],
    "composerIcon": "./assets/icon.svg",
    "logo": "./assets/icon.svg",
    "logoDark": "./assets/icon.svg",
    "brandColor": "#0F766E",
    "screenshots": []
  }
}

